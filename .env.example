# Absolute site URL used for Open Graph metadata. No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Leave unset until email delivery is connected.
# When RESEND_API_KEY is present the contact route still reports
# not-implemented until the Resend call is added in src/app/api/contact/route.ts.
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=
